# Neon Postgres — pooled endpoint for app runtime (serverless-friendly)
DATABASE_URL=""
# Direct (unpooled) endpoint — used by drizzle-kit for migrations only
DATABASE_URL_UNPOOLED=""

# NextAuth
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public app URL — used for absolute links in emails, sitemap, metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brevo (transactional email — password reset)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="support@notto.site"
BREVO_SENDER_NAME="Notto"

# Gumroad (payment — hosted checkout for Lifetime All Access)
# GUMROAD_PRODUCT_URL: the product's public checkout link (e.g. https://<seller>.gumroad.com/l/<permalink>)
# GUMROAD_ACCESS_TOKEN: personal access token, Settings → Advanced → Applications (needs "View sales and use the Ping" scope)
# GUMROAD_WEBHOOK_TOKEN: random secret you choose — appended as ?token=... on the resource_subscription callback URL
GUMROAD_PRODUCT_URL=""
GUMROAD_ACCESS_TOKEN=""
GUMROAD_WEBHOOK_TOKEN=""

# Cloudflare R2 (template image asset storage — mirrors third-party-hosted images)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
